{
  "name": "replicalab",
  "version": "1.0.0",
  "description": "ReplicaLab - Workflow Orchestration Platform",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "dev:worker": "npm run dev:worker --prefix server",
    "worker": "npm run worker --prefix server",
    "install:all": "npm install --prefix server && npm install --prefix client",
    "build:client": "npm run build --prefix client",
    "test:server": "npm test --prefix server",
    "start": "npm run start --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
