# ReplicaLab Server Environment Configuration

# Server Port (default: 5000)
PORT=5000

# Application Environment (development | production | test)
NODE_ENV=development

# MongoDB Atlas Connection URI
# Replace with your actual MongoDB Atlas connection string in your local .env file.
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/replicalab?retryWrites=true&w=majority

# Allowed Frontend Client Origin for CORS
CLIENT_URL=http://localhost:5173

# Worker Engine Configuration
DEFAULT_EXECUTION_ENGINE=legacy
WORKER_CONCURRENCY=2
WORKER_POLLING_INTERVAL_MS=1000
WORKER_LEASE_DURATION_MS=30000
WORKER_TASK_TIMEOUT_MS=15000
WORKER_SHUTDOWN_TIMEOUT_MS=10000

# Retries and Exponential Backoff Configuration
RETRY_BASE_DELAY_MS=1000
RETRY_MAX_DELAY_MS=30000

# Reaper (Zombie Lease Recovery) Configuration
REAPER_INTERVAL_MS=10000
REAPER_BATCH_SIZE=50

# Logging Configuration
LOG_FORMAT=text
LOG_LEVEL=info

# JWT Authentication Configuration
# In production, JWT_SECRET must be at least 32 characters long.
# Generate a secure key e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_for_production
JWT_EXPIRES_IN=15m

# Persistent Refresh Session & Cookie Configuration
# REFRESH_COOKIE_NAME: Name of the HttpOnly cookie storing the opaque refresh token
REFRESH_COOKIE_NAME=replicalab_refresh_token
# REFRESH_TOKEN_EXPIRES_DAYS: Refresh session lifetime in days (default: 7)
REFRESH_TOKEN_EXPIRES_DAYS=7
# COOKIE_SAME_SITE: SameSite cookie policy (lax | strict | none). Defaults to 'lax' in dev, 'strict' in prod.
COOKIE_SAME_SITE=lax
# TRUST_PROXY: Reverse proxy configuration for rate limiters and secure cookies (false | true | <hop_count>)
# Leave false when directly exposed; set to true or hop count when behind Nginx, ALB, or Cloudflare with TLS termination.
TRUST_PROXY=false


